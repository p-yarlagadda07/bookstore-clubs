# Copy this file to .env and fill in the values (the team lead will DM you the secrets).
# Never commit .env.

# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas) - shared privately by the team lead
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/bookstore?retryWrites=true&w=majority

# Sessions and CSRF (Member 2) - any long random strings for local dev
SESSION_SECRET=change-me-to-a-long-random-string
CSRF_SECRET=change-me-to-another-long-random-string

# Email (Member 2) - create a free test account at https://ethereal.email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# AI (Members 6, 7, 8) - Ollama running locally
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
AGENT_MODE=tools
